{
  "name": "wist",
  "version": "0.0.0",
  "private": true,
  "description": "Portable project context and capability contracts for AI assistants.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome format . && oxlint . && turbo run typecheck && turbo run test",
