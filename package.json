    "lint": "oxlint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "24.13.6",
    "oxlint": "1.83.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
