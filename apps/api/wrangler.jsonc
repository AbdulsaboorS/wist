{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wist-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  // Keeps the workers.dev address alive for @wist/cli 0.1.0, which points at it.
  "workers_dev": true,
  "routes": [{ "pattern": "relay.wist.fyi", "custom_domain": true }],
  "triggers": { "crons": ["17 * * * *"] },
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-passport",
      "database_id": "9daa02bc-929e-4c72-9cc4-f4e9ddcc7a4d",
      "migrations_dir": "../../d1/migrations"
    }
  ]
}
