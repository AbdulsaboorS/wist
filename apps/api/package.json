{
  "name": "@wist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "wrangler dev --config wrangler.jsonc",
    "dev:node": "node --enable-source-maps dist/server.js",
    "d1:migrate:local": "wrangler d1 migrations apply agent-passport --local --config wrangler.jsonc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wist/domain": "workspace:*",
    "@wist/fixtures": "workspace:*",
    "@wist/intelligence": "workspace:*",
    "@hono/node-server": "1.19.11",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260915.1",
    "miniflare": "4.20260730.0",
    "wrangler": "4.132.0"
  }
}
